{
  "name": "bulletproof-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "A production-ready standalone Next.js application shell.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0 <25",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "env:check": "bun run scripts/check-env.ts",
    "architecture:check": "bun run scripts/check-architecture.ts",
    "dependencies:check": "bun run scripts/check-dependencies.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "bun run build && bun run scripts/run-e2e.ts",
    "e2e:run": "bun run scripts/run-e2e.ts",
    "verify": "bun run env:check && bun run architecture:check && bun run dependencies:check && bun run typecheck && bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "next": "16.2.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@tanstack/react-query-devtools": "5.101.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "postcss": "8.5.18",
    "shadcn": "4.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "postcss": "8.5.15"
  }
}
